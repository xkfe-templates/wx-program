/* 全局 CSS 变量定义 */
page {
  /* 主色调 */
  --primary-color: #1989fa;
  --primary-light: #5cadff;
  --primary-dark: #1462b0;

  /* 辅助色 */
  --success-color: #09BE4F;
  --warning-color: #FFB703;
  --danger-color: #FF2B2B;
  --purple-color: #6831FF;
  --info-color: #969799;

  /* 文字颜色 */
  --text-color: #333;
  --text-color-secondary: #666;
  --text-color-tertiary: #999;
  --text-color-light: #ccc;
  --text-color-inverse: #fff;

  /* 背景颜色 */
  --bg-color: #f5f5f5;
  --bg-color-white: #fff;
  --bg-color-gray: #f7f8fa;
  --bg-color-dark: #333;

  /* 边框颜色 */
  --border-color: #ebedf0;
  --border-color-dark: #d9d9d9;
  --border-color-light: #f0f0f0;

  /* 字体大小 */
  --font-size-xs: 20rpx;
  --font-size-sm: 24rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-xxl: 40rpx;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --spacing-xxl: 64rpx;

  /* 圆角 */
  --border-radius-sm: 4rpx;
  --border-radius-md: 8rpx;
  --border-radius-lg: 16rpx;
  --border-radius-xl: 24rpx;
  --border-radius-max: 999rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 8rpx 16rpx rgba(0, 0, 0, 0.15);
}
