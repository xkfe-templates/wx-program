.empty__wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty__fixed {
  position: fixed;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  z-index: 99;
}

.empty__title {
  text-align: center;
  font-weight: 500;
  padding-top: 24rpx;
}

.empty__desc {
  text-align: center;
  font-weight: normal;
  padding-top: 8rpx;
}

.empty__title-color {
  color: var(--text-color-secondary, #333333) !important;
}

.empty__descr-color {
  color: var(--text-color-tertiary, #B2B2B2) !important;
}