.loadmore__wrap {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loadmore__col {
  flex-direction: column;
}

.loadmore__row {
  flex-direction: row;
}

.loadmore__icon {
  margin: 0 6px;
  border-width: 2px;
  border-style: solid;
  border-radius: 50%;
  animation: rotate 0.7s linear infinite;
}

.loadmore__icon-ani {
  margin: 0 6px;
  display: block;
  animation: rotate 0.7s linear infinite;
}

.loadmore__text {
  padding-top: 16rpx;
}

.loadmore__border-left {
  border-left-color: var(--primary-color, #465CFF) !important;
}

@-webkit-keyframes rotate {
  0% {
    transform: rotate(0);
  }

  100% {
    transform: rotate(360deg);
  }
}

@keyframes rotate {
  0% {
    transform: rotate(0);
  }

  100% {
    transform: rotate(360deg);
  }
}